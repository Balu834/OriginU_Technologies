      "destination": "/api/logout"
    },
    {
      "source": "/missed-call",
      "destination": "/api/missed-call"
    },
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
