{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/landing"
    },
    {
      "source": "/leads",
      "destination": "/api/dashboard"
    },
    {
      "source": "/lead",
      "destination": "/api/lead-detail"
    },
    {
      "source": "/leads/status",
      "destination": "/api/lead-status"
    },
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
