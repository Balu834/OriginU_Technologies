# --- Meta WhatsApp Cloud API credentials ---
# developers.facebook.com -> your app -> WhatsApp -> API Setup
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Any string you choose; paste the same one into Meta's webhook config.
META_VERIFY_TOKEN=
# App Dashboard -> Settings -> Basic -> App Secret. Used to verify that
# inbound webhook requests genuinely came from Meta (X-Hub-Signature-256),
# and to exchange the Embedded Signup code below. Never sent to a browser.
META_APP_SECRET=

# --- Customer-facing WhatsApp connection (Embedded Signup) ---
# These make the "Connect WhatsApp" button on /settings/whatsapp work, so a
# business owner signs in with Meta instead of copying API credentials.
# With either one blank the page says one-click connection isn't available
# and offers Advanced (manual) setup — it never renders a dead button.
#
# META_APP_ID: App Dashboard -> Settings -> Basic -> App ID. Public by
# design; it is sent to the browser to initialise Meta's SDK.
META_APP_ID=
# The Facebook Login for Business configuration id created under
# App Dashboard -> Facebook Login for Business -> Configurations, with the
# WhatsApp Embedded Signup use case. Also public.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Graph version used by the signup flow only (the send and verify paths
# pin their own). Bump this when Meta retires a version.
META_GRAPH_VERSION=v23.0
# Six-digit two-step PIN set on a number when it is registered for Cloud
# API after signup. Leave blank and registration is SKIPPED rather than a
# PIN being invented that nobody could reproduce later.
WHATSAPP_REGISTER_PIN=

# Encrypts each business's WhatsApp credentials at rest (AES-256-GCM).
# 64 hex characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it no per-business integration can be stored.
INTEGRATION_ENCRYPTION_KEY=

# --- Business identity ---
BUSINESS_NAME=Planet Electrical
OWNER_NAME=Mohamed
# Where leads and emergency alerts get sent — the owner's personal WhatsApp, E.164.
MOHAMED_WHATSAPP_NUMBER=+919876543210

# Public HTTPS URL this service is reachable at (for reference/docs; point
# Meta's webhook config at ${WEBHOOK_BASE_URL}/webhook).
WEBHOOK_BASE_URL=

# --- Missed-call ingestion ---
# Shared secret the phone automation (MacroDroid/Tasker) sends as
# `Authorization: Bearer <this>` when it POSTs /missed-call.
MISSED_CALL_API_KEY=

# --- Leads dashboard ---
# Password for the dashboard at "/", stored as a salted scrypt hash
# ("salt:hash"), never as plaintext. Generate one with:
#   node scripts/hash-password.mjs "your password"
# Leave empty and the dashboard refuses to serve rather than running open.
DASHBOARD_PASSWORD_HASH=

# --- WhatsApp templates ---
# Must already be approved by Meta under category UTILITY before use — see
# templates.json and README.md.
WHATSAPP_MISSED_CALL_TEMPLATE=missed_call_immediate
WHATSAPP_TEMPLATE_LANGUAGE=en

PORT=3000

# --- Storage (production) ---
# The Vercel deployment has no disk, so it uses Upstash Redis instead of
# the local JSON file. Both are set automatically by `vercel install
# upstash`; the serverless functions refuse to start without them. Local
# runs ignore these and use data/db.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------- Razorpay
# Billing. Leave every value blank to run with payments switched off: the
# billing page then says paid plans are unavailable, checkout returns 503,
# and the webhook refuses everything rather than trusting it.
#
# Use TEST mode keys (rzp_test_...) until a real launch. Only RAZORPAY_KEY_ID
# is ever sent to a browser — Razorpay's checkout.js requires it and it is
# public by design. The other two must never leave the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The Razorpay Plan to bill PRO against. Create it in the Razorpay dashboard
# at ₹299/month (amount 29900, currency INR, period monthly) to match
# PLAN_PRICING.PRO in lib/billing.mjs — checkout refuses to run if the two
# disagree, rather than charging a price we did not display.
RAZORPAY_PLAN_ID_PRO=

# No RAZORPAY_PLAN_ID_BUSINESS: the BUSINESS plan has no agreed price, so it
# is not purchasable and there is nothing for a plan id to point at.

# --- Password reset email (Resend) ---
# RESET_EMAIL_FROM must be on a domain verified in Resend, e.g.
# "MissedCall <no-reply@originutech.in>". PUBLIC_BASE_URL is the https origin
# used in the emailed link. Leave any blank and /forgot-password says email
# reset is unavailable.
RESEND_API_KEY=
RESET_EMAIL_FROM=
PUBLIC_BASE_URL=
