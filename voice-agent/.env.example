# Vapi handles the voice stack — speech-to-text, the LLM turn-taking, the
# telephony leg. Get this from dashboard.vapi.ai -> API Keys (private key).
VAPI_API_KEY=

# Only needed to place outbound calls (setup.mjs --call).
# Provision a number in the Vapi dashboard -> Phone Numbers, then paste its id.
# NOTE: Vapi's instant free numbers are US (+1). Dialling India FROM a US
# number works and is what the demo uses. Getting an actual Indian (+91)
# inbound number is a separate, slower problem — see README.
VAPI_PHONE_NUMBER_ID=
